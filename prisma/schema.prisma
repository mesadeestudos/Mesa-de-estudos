generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["auth", "concurso", "planejamento"]
}

model credencial {
  id_credencial         BigInt    @id @default(autoincrement())
  id_usuario            BigInt    @unique
  senha_hash            String
  ultimo_login          DateTime? @db.Timestamptz(6)
  reset_token           String?
  reset_token_expira_em DateTime? @db.Timestamptz(6)
  usuario               usuario   @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade, onUpdate: NoAction)

  @@schema("auth")
}

model sessao {
  id_sessao     BigInt    @id @default(autoincrement())
  id_usuario    BigInt
  refresh_token String
  user_agent    String?
  ip_address    String?
  expira_em     DateTime  @db.Timestamptz(6)
  revogado      Boolean?  @default(false)
  data_criacao  DateTime? @default(now()) @db.Timestamptz(6)
  usuario       usuario   @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade, onUpdate: NoAction)

  @@index([refresh_token], map: "idx_refresh_token")
  @@index([id_usuario], map: "idx_sessao_usuario")
  @@schema("auth")
}

model usuario {
  id_usuario                  BigInt                     @id @default(autoincrement())
  nome_completo               String                     @db.VarChar(150)
  nome_usuario                String?                    @unique @db.VarChar(30)
  email                       String                     @unique @db.VarChar(150)
  foto_url                    String?
  ativo                       Boolean?                   @default(true)
  primeiro_acesso             Boolean?                   @default(true)
  data_criacao                DateTime?                  @default(now()) @db.Timestamptz(6)
  email_verificado            Boolean?                   @default(false)
  email_verificacao_token     String?
  email_verificacao_expira_em DateTime?                  @db.Timestamp(6)
  credencial                  credencial?
  sessao                      sessao[]
  disciplina_nivel_usuario    disciplina_nivel_usuario[]
  disciplina_progresso        disciplina_progresso[]
  plano_estudo                plano_estudo[]
  sessao_estudo               sessao_estudo[]
  topico_progresso            topico_progresso[]

  @@index([email], map: "idx_usuario_email")
  @@schema("auth")
}

model banca {
  id_banca Int      @id @default(autoincrement())
  nome     String   @unique @db.VarChar(150)
  sigla    String?  @unique @db.VarChar(20)
  edital   edital[]

  @@schema("concurso")
}

model cargo {
  id_cargo     Int            @id @default(autoincrement())
  id_edital    Int?
  nome         String         @db.VarChar(150)
  edital       edital?        @relation(fields: [id_edital], references: [id_edital], onDelete: Cascade, onUpdate: NoAction)
  disciplina   disciplina[]
  plano_estudo plano_estudo[]

  @@schema("concurso")
}

model concurso {
  id_concurso Int      @id @default(autoincrement())
  nome        String   @db.VarChar(255)
  id_orgao    Int
  sigla       String?  @db.VarChar(50)
  orgao       orgao    @relation(fields: [id_orgao], references: [id_orgao], onDelete: NoAction, onUpdate: NoAction)
  edital      edital[]

  @@schema("concurso")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model disciplina {
  id_disciplina            Int                        @id @default(autoincrement())
  id_cargo                 Int?
  nome                     String                     @db.VarChar(100)
  peso                     Decimal?                   @default(1.0) @db.Decimal(4, 2)
  qtd_questoes             Int?
  tipo                     String                     @default("B") @db.Char(1)
  categoria_cognitiva      String                     @default("M") @db.Char(1)
  cargo                    cargo?                     @relation(fields: [id_cargo], references: [id_cargo], onDelete: Cascade, onUpdate: NoAction)
  topico                   topico[]
  ciclo_disciplina         ciclo_disciplina[]
  disciplina_nivel_usuario disciplina_nivel_usuario[]
  disciplina_progresso     disciplina_progresso[]
  sessao_estudo            sessao_estudo[]

  @@unique([id_cargo, nome])
  @@index([id_cargo], map: "idx_disciplina_cargo")
  @@schema("concurso")
}

model edital {
  id_edital   Int       @id @default(autoincrement())
  id_concurso Int?
  ano         Int
  id_banca    Int?
  ativo       Boolean?  @default(true)
  status      String?   @db.VarChar(20)
  data_prova  DateTime? @db.Date
  cargo       cargo[]
  banca       banca?    @relation(fields: [id_banca], references: [id_banca], onDelete: NoAction, onUpdate: NoAction)
  concurso    concurso? @relation(fields: [id_concurso], references: [id_concurso], onDelete: Cascade, onUpdate: NoAction)

  @@schema("concurso")
}

model orgao {
  id_orgao Int        @id @default(autoincrement())
  nome     String     @unique @db.VarChar(150)
  sigla    String?    @unique @db.VarChar(20)
  concurso concurso[]

  @@schema("concurso")
}

model topico {
  id_topico        BigInt             @id @default(autoincrement())
  id_disciplina    Int?
  descricao        String
  ordem            Int?
  disciplina       disciplina?        @relation(fields: [id_disciplina], references: [id_disciplina], onDelete: Cascade, onUpdate: NoAction)
  sessao_estudo    sessao_estudo[]
  topico_progresso topico_progresso[]

  @@unique([id_disciplina, ordem])
  @@index([id_disciplina], map: "idx_topico_disciplina")
  @@schema("concurso")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model ciclo_disciplina {
  id_ciclo_disciplina BigInt          @id @default(autoincrement())
  id_ciclo            BigInt
  id_disciplina       Int
  ordem               Int
  horas_planejadas    Decimal         @db.Decimal(4, 2)
  ciclo_estudo        ciclo_estudo    @relation(fields: [id_ciclo], references: [id_ciclo], onDelete: Cascade, onUpdate: NoAction)
  disciplina          disciplina      @relation(fields: [id_disciplina], references: [id_disciplina], onDelete: NoAction, onUpdate: NoAction)
  sessao_estudo       sessao_estudo[]

  @@unique([id_ciclo, ordem])
  @@index([id_ciclo, ordem], map: "idx_ciclo_disciplina_ordem")
  @@schema("planejamento")
}

model ciclo_estudo {
  id_ciclo         BigInt             @id @default(autoincrement())
  id_plano         BigInt
  data_inicio      DateTime?          @default(dbgenerated("CURRENT_DATE")) @db.Date
  data_fim         DateTime?          @db.Date
  ativo            Boolean?           @default(true)
  ciclo_disciplina ciclo_disciplina[]
  plano_estudo     plano_estudo       @relation(fields: [id_plano], references: [id_plano], onDelete: Cascade, onUpdate: NoAction)
  ciclo_execucao   ciclo_execucao?

  @@index([id_plano], map: "idx_ciclo_plano")
  @@schema("planejamento")
}

model ciclo_execucao {
  id_execucao          BigInt       @id @default(autoincrement())
  id_ciclo             BigInt       @unique
  posicao_atual        Int          @default(1)
  data_ultima_execucao DateTime?    @db.Timestamptz(6)
  ciclo_estudo         ciclo_estudo @relation(fields: [id_ciclo], references: [id_ciclo], onDelete: Cascade, onUpdate: NoAction)

  @@index([id_ciclo], map: "idx_execucao_ciclo")
  @@schema("planejamento")
}

model disciplina_progresso {
  id_disciplina_progresso BigInt     @id @default(autoincrement())
  id_usuario              BigInt
  id_disciplina           Int
  total_topicos           Int
  topicos_concluidos      Int?       @default(0)
  percentual              Decimal?   @default(dbgenerated("\nCASE\n    WHEN (total_topicos = 0) THEN (0)::numeric\n    ELSE (((topicos_concluidos)::numeric * 100.0) / (total_topicos)::numeric)\nEND")) @db.Decimal(5, 2)
  concluida               Boolean?   @default(false)
  disciplina              disciplina @relation(fields: [id_disciplina], references: [id_disciplina], onDelete: Cascade, onUpdate: NoAction)
  usuario                 usuario    @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade, onUpdate: NoAction)

  @@unique([id_usuario, id_disciplina])
  @@schema("planejamento")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model plano_estudo {
  id_plano      BigInt         @id @default(autoincrement())
  id_usuario    BigInt
  id_cargo      Int
  metodo        String         @default("FLEXIVEL") @db.VarChar(20)
  horas_por_dia Decimal        @db.Decimal(4, 2)
  data_criacao  DateTime?      @default(now()) @db.Timestamptz(6)
  ritmo         String         @default("EQUILIBRADO") @db.VarChar(20)
  ciclo_estudo  ciclo_estudo[]
  cargo         cargo          @relation(fields: [id_cargo], references: [id_cargo], onDelete: NoAction, onUpdate: NoAction)
  usuario       usuario        @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade, onUpdate: NoAction)

  @@schema("planejamento")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model sessao_estudo {
  id_sessao           BigInt            @id @default(autoincrement())
  id_usuario          BigInt
  id_disciplina       Int
  id_topico           BigInt
  inicio              DateTime          @default(now()) @db.Timestamptz(6)
  fim                 DateTime?         @db.Timestamptz(6)
  duracao_minutos     Int?
  status              String            @db.VarChar(20)
  id_ciclo_disciplina BigInt?
  qualidade           String?           @db.VarChar(20)
  ciclo_disciplina    ciclo_disciplina? @relation(fields: [id_ciclo_disciplina], references: [id_ciclo_disciplina], onUpdate: NoAction)
  disciplina          disciplina        @relation(fields: [id_disciplina], references: [id_disciplina], onDelete: NoAction, onUpdate: NoAction)
  topico              topico            @relation(fields: [id_topico], references: [id_topico], onDelete: NoAction, onUpdate: NoAction)
  usuario             usuario           @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade, onUpdate: NoAction)

  @@index([id_usuario, status], map: "idx_sessao_estudo_status")
  @@index([id_usuario], map: "idx_sessao_estudo_usuario")
  @@index([id_ciclo_disciplina], map: "idx_sessao_estudo_ciclo_disciplina")
  @@schema("planejamento")
}

model topico_progresso {
  id_topico_progresso BigInt    @id @default(autoincrement())
  id_usuario          BigInt
  id_topico           BigInt
  concluido           Boolean?  @default(false)
  data_conclusao      DateTime? @db.Timestamptz(6)
  topico              topico    @relation(fields: [id_topico], references: [id_topico], onDelete: Cascade, onUpdate: NoAction)
  usuario             usuario   @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade, onUpdate: NoAction)

  @@unique([id_usuario, id_topico])
  @@schema("planejamento")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model disciplina_nivel_usuario {
  id_nivel         BigInt     @id @default(autoincrement())
  id_usuario       BigInt
  id_disciplina    Int
  nivel            String     @db.VarChar(10)
  data_atualizacao DateTime?  @default(now()) @db.Timestamptz(6)
  disciplina       disciplina @relation(fields: [id_disciplina], references: [id_disciplina], onDelete: Cascade, onUpdate: NoAction)
  usuario          usuario    @relation(fields: [id_usuario], references: [id_usuario], onDelete: Cascade, onUpdate: NoAction)

  @@unique([id_usuario, id_disciplina])
  @@schema("planejamento")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model ajuste_plano_usuario {
  id_ajuste_plano BigInt   @id @default(autoincrement())
  id_usuario      BigInt
  tipo            String   @db.VarChar(30)
  data_inicio     DateTime @db.Timestamptz(6)
  data_fim        DateTime @db.Timestamptz(6)
  horas_por_dia   Decimal? @db.Decimal(4, 2)
  motivo          String?
  data_criacao    DateTime @default(now()) @db.Timestamptz(6)

  @@index([id_usuario, data_inicio, data_fim], map: "idx_ajuste_plano_usuario_periodo")
  @@index([id_usuario, tipo], map: "idx_ajuste_plano_usuario_tipo")
  @@schema("planejamento")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model assinatura_usuario {
  id_assinatura            BigInt    @id @default(autoincrement())
  id_usuario               BigInt
  plano                    String    @db.VarChar(40)
  status                   String    @db.VarChar(30)
  provider                 String    @default("MOCK") @db.VarChar(30)
  provider_customer_id     String?   @db.VarChar(120)
  provider_subscription_id String?   @db.VarChar(120)
  checkout_id              String?   @db.VarChar(120)
  valor_centavos           Int?
  data_inicio              DateTime  @default(now()) @db.Timestamptz(6)
  data_fim                 DateTime? @db.Timestamptz(6)
  data_cancelamento        DateTime? @db.Timestamptz(6)
  data_criacao             DateTime  @default(now()) @db.Timestamptz(6)
  data_atualizacao         DateTime  @default(now()) @db.Timestamptz(6)

  @@index([checkout_id], map: "idx_assinatura_checkout")
  @@index([id_usuario, status], map: "idx_assinatura_usuario_status")
  @@schema("planejamento")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model diagnostico_inicial_usuario {
  id_diagnostico        BigInt   @id @default(autoincrement())
  id_usuario            BigInt   @unique
  nivel_atual           String   @db.VarChar(30)
  dias_ate_prova        Int?
  estudou_edital_antes  Boolean  @default(false)
  dificuldade_principal String   @db.VarChar(40)
  preferencia_sessao    String   @db.VarChar(30)
  materias_temidas      String[] @default([])
  objetivo              String?
  data_criacao          DateTime @default(now()) @db.Timestamptz(6)
  data_atualizacao      DateTime @default(now()) @db.Timestamptz(6)

  @@index([id_usuario], map: "idx_diagnostico_inicial_usuario")
  @@schema("planejamento")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model questao_treino {
  id_questao_treino BigInt   @id @default(autoincrement())
  id_usuario        BigInt
  id_disciplina     Int
  id_topico         BigInt?
  total_questoes    Int
  total_acertos     Int
  percentual        Decimal  @db.Decimal(5, 2)
  motivo_erro       String?  @db.VarChar(40)
  confianca         String?  @db.VarChar(30)
  observacao        String?
  data_registro     DateTime @default(now()) @db.Timestamptz(6)

  @@index([id_usuario, id_disciplina], map: "idx_questao_treino_disciplina")
  @@index([id_usuario, motivo_erro], map: "idx_questao_treino_motivo")
  @@index([id_usuario, id_topico], map: "idx_questao_treino_topico")
  @@index([id_usuario], map: "idx_questao_treino_usuario")
  @@schema("planejamento")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model simulado {
  id_simulado         BigInt                @id @default(autoincrement())
  id_usuario          BigInt
  titulo              String                @db.VarChar(160)
  data_realizacao     DateTime              @default(dbgenerated("CURRENT_DATE")) @db.Date
  total_questoes      Int
  total_acertos       Int
  percentual          Decimal               @db.Decimal(5, 2)
  observacao          String?
  data_criacao        DateTime              @default(now()) @db.Timestamptz(6)
  simulado_disciplina simulado_disciplina[]

  @@index([id_usuario, data_realizacao(sort: Desc)], map: "idx_simulado_usuario_data")
  @@schema("planejamento")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model simulado_disciplina {
  id_simulado_disciplina BigInt   @id @default(autoincrement())
  id_simulado            BigInt
  id_disciplina          Int
  total_questoes         Int
  total_acertos          Int
  percentual             Decimal  @db.Decimal(5, 2)
  simulado               simulado @relation(fields: [id_simulado], references: [id_simulado], onDelete: Cascade, onUpdate: NoAction)

  @@index([id_disciplina, percentual], map: "idx_simulado_disciplina")
  @@schema("planejamento")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model sugestao_usuario {
  id_sugestao      BigInt   @id @default(autoincrement())
  id_usuario       BigInt
  categoria        String   @db.VarChar(40)
  prioridade       String   @default("NORMAL") @db.VarChar(20)
  titulo           String   @db.VarChar(140)
  descricao        String
  status           String   @default("NOVA") @db.VarChar(30)
  pagina_origem    String?  @db.VarChar(120)
  data_criacao     DateTime @default(now()) @db.Timestamptz(6)
  data_atualizacao DateTime @default(now()) @db.Timestamptz(6)

  @@index([status, data_criacao(sort: Desc)], map: "idx_sugestao_status")
  @@index([id_usuario, data_criacao(sort: Desc)], map: "idx_sugestao_usuario_data")
  @@schema("planejamento")
}